# Python
__pycache__/
*.pyc
*.pyo

# Build / extract artifacts (CI uses these dirs locally, never commit)
build/
artifacts/
dist/
*.zip
*.asar
*.asar.bak*
*.asar.tmp

# Codex Desktop binary itself — we never check in the app
Codex.exe
codex.exe
*.dll
*.pak
*.dat
*.bin
LICENSES.chromium.html
locales/
resources/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor noise
.vscode/
.idea/
*.swp
*~

# Local agent / tooling state
.omc/
.omx/
.aider*

# Per-feature scratch space (extracted asar chunks, schema dumps, POC scripts).
# Never committed — see CLAUDE.md "Temp scripts go in temp_scripts/ folder".
temp_scripts/
tmp_scripts/

# Local incident scratch. These can contain extracted upstream binaries,
# temporary remote probes, or a cloned internal service repository.
.tmp/
.tmp-*/
.tmp-*.ps1

# Repatch scratch dirs (tmp-<topic>-<upstream build>): a full upstream download,
# the extracted app, and per-patch app.asar backups. Multi-GB, never committed.
tmp-*/

# Private operator handoffs and machine state stay local, including after a pull.
.local/
/HANDOFF*.md
/DEV_HANDOFF.md
/docs/HANDOFF*.md
/docs/2026-07-10-codex-patched-update-handoff.md
/docs/codex-relay-dev-handoff.md
.env
.env.*
!.env.example
/auth.json
/config.toml
/mcp-secrets*.json
*.log
*.dmp
*.sqlite
*.sqlite-*
